rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /links/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid
        || request.auth.uid == get(/databases/$(db)/documents/config/creator).data.uid);
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource.data.premium != true
            || exists(/databases/$(db)/documents/codes/$(request.resource.data.code)));
    }
    match /codes/{c} { allow get: if request.auth != null; allow list: if false; }
    match /config/{d} { allow read: if request.auth != null; }
    match /links/{linkId}/views/{viewId} {
      allow create: if request.auth != null && request.resource.data.viewerId == request.auth.uid;
      allow read: if request.auth != null && (
        request.auth.uid == get(/databases/$(db)/documents/links/$(linkId)).data.authorId ||
        request.auth.uid == get(/databases/$(db)/documents/config/creator).data.uid
      );
      allow update, delete: if false;
    }
  }
}
